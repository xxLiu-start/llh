# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Reproducible skill experiments: source/configs remain reviewable; preserve
# raw runs and local worktree metadata without accidentally committing them.
experiments/skill_evolution/worktrees/
experiments/skill_evolution/protection/
experiments/skill_evolution/results/
experiments/skill_evolution/libraries/
experiments/skill_evolution/compat/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*

# Local environments
.cache/
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/
node_modules/

# Vite builds the Web bundle into the package. It is never committed; the
# release workflow builds it before packaging.
src/lh_harness/_frontend/

# package-lock.json is the authority used by CI; bun may be used locally but
# its lockfile is not committed so the two cannot drift.
bun.lock
bun.lockb

# Local run outputs
.lh-harness/
runs/
logs/
results/
tmp/

# Secrets and local overrides
.env
*.env
env.local.sh
*.local.sh
*.mcp.json

# Editor/system
.DS_Store
.idea/
.vscode/
.lh-harness-quickstart/

# Skill learning and benchmark run artifacts
output/
*.log

# 训练数据集
train_dataset/

# Terminal-Bench 评估数据集
eval/TB-harness/datasets/

# Python 缓存
__pycache__/
*.pyc
.pytest_cache/

# 环境变量及密钥
.env
.env.*

# Machine-specific experiment history and publication exclusions.
/his/
/archive/skill-evolution-preservation/
/evaluation/validation/
/experiments/skill_evolution/validation/
/experiments/skill_evolution/manifests/current-paired-run.json
/experiments/skill_evolution/manifests/training-runs.json
/experiments/skill_evolution/manifests/enhanced-worktree-snapshot.json
/experiments/skill_evolution/manifests/delivery.json
